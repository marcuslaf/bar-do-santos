# ============================================
# .env.example — bar-do-santos
# Copie para apps/web/.env.local (Next.js) e para .env na raiz (CLI/Docker)
# NUNCA commite .env nem .env.local
# ============================================

# === SUPABASE — exposto ao browser (RLS protege os dados) ===
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[ANON_KEY]

# === SUPABASE — SOMENTE SERVIDOR ===
# Nunca use o prefixo NEXT_PUBLIC_ nesta chave: ela ignora RLS.
SUPABASE_SERVICE_ROLE_KEY=[SERVICE_ROLE_KEY]

# === SUPABASE CLI (migrations) ===
SUPABASE_PROJECT_REF=[PROJECT_REF]
SUPABASE_DB_PASSWORD=[DB_PASSWORD]

# === APP ===
APP_URL=http://localhost:3000

# === DESENVOLVIMENTO LOCAL (supabase start) ===
# O comando `supabase start` imprime API URL e anon key locais.
# Use esses valores em apps/web/.env.local durante o desenvolvimento:
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key impressa pelo CLI>
#   SUPABASE_SERVICE_ROLE_KEY=<service_role key impressa pelo CLI>
