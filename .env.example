# ============================================
# .env.example - Foundation Template
# Copie para .env e preencha com valores reais
# NUNCA commit o arquivo .env
# ============================================

# === DATABASE (Supabase) ===
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=[SUA_CHAVE_ANON]
SUPABASE_SERVICE_ROLE_KEY=[CHAVE_SERVICE_ROLE_SOMENTE_SERVER]
SUPABASE_JWT_SECRET=[SEGREDO_JWT]

# === AUTH ===
NEXTAUTH_SECRET=[GERE_COM_openssl_rand_hex_32]
NEXTAUTH_URL=http://localhost:3000

# === API KEYS (nunca no client-side) ===
OPENAI_API_KEY=sk-[CHAVE]
STRIPE_SECRET_KEY=sk_[CHAVE]
STRIPE_PUBLISHABLE_KEY=pk_[CHAVE]
RESEND_API_KEY=re_[CHAVE]

# === WEBHOOKS (verificar HMAC) ===
STRIPE_WEBHOOK_SECRET=whsec_[CHAVE]
GITHUB_WEBHOOK_SECRET=[CHAVE]

# === EXTERNAL SERVICES ===
SENTRY_DSN=https://[CHAVE]@sentry.io/[PROJETO]
POSTHOG_KEY=phc_[CHAVE]

# === APP CONFIG ===
NODE_ENV=development
APP_URL=http://localhost:3000

# === EMAIL (Supabase Auth) ===
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=[USUARIO]
SMTP_PASSWORD=[SENHA]
SMTP_FROM=noreply@seudominio.com

# === STACK ESPECIFICO (adicionado pelo scaffolder) ===
JWT_SECRET=[GERE_min_32_chars_ex_openssl_rand_hex_32]
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
